{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix prototypes/spatial-study",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/poker/:path*",
      "destination": "https://scarlet-poker.onrender.com/:path*",
      "permanent": false
    }
  ]
}
